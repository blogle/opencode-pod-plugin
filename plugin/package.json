{
  "name": "@opencode/k8s-sandbox-plugin",
  "version": "0.1.0",
  "description": "OpenCode native Kubernetes workspace adapter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["opencode", "kubernetes", "workspace"],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@opencode-ai/sdk": "1.18.3"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "5.9.2",
    "vitest": "1.6.1",
    "eslint": "8.57.1",
    "@typescript-eslint/parser": "6.21.0",
    "@typescript-eslint/eslint-plugin": "6.21.0"
  }
}
