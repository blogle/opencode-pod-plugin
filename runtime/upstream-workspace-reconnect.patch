+        .where(eq(SessionTable.workspace_id, space.id))
+        .all()
+        .pipe(Effect.orDie)).map((row) => row.id)
+
+      yield* Effect.forEach(
+        sessionIDs,
+        (sessionID) =>
+          Effect.gen(function* () {
+            const rows = (yield* db
+              .select({
+                id: EventTable.id,
+                aggregateID: EventTable.aggregate_id,
+                seq: EventTable.seq,
+                type: EventTable.type,
+                data: EventTable.data,
