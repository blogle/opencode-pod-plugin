+              if (response.status < 200 || response.status >= 300) {
+                return yield* new SyncHttpError({
+                  message: `Workspace replay HTTP failure: ${response.status}`,
+                  status: response.status,
+                })
+              }
+            }
+            const response = yield* http.execute(
+              HttpClientRequest.post(route(url, "/sync/steal"), {
+                headers: new Headers(headers),
+                body: HttpBody.jsonUnsafe({ sessionID }),
+              }),
+            )
+            if (response.status < 200 || response.status >= 300) {
+              return yield* new SyncHttpError({
+                message: `Workspace steal HTTP failure: ${response.status}`,
+                status: response.status,
+              })
+            }
+          }),
+        { discard: true },
+      )
+    })
