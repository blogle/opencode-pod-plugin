+        return yield* new SyncHttpError({
+          message: `Workspace state HTTP failure: ${historyResponse.status}`,
+          status: historyResponse.status,
+        })
+      }
+      const childState = new Map<string, number>()
+      for (const event of (yield* historyResponse.json) as HistoryEvent[]) {
+        childState.set(event.aggregate_id, Math.max(childState.get(event.aggregate_id) ?? -1, event.seq))
+      }
+      const sessionIDs = (yield* db
+        .select({ id: SessionTable.id })
