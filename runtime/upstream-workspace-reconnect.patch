+    const restoreWorkspaceSessions = Effect.fn("Workspace.restoreWorkspaceSessions")(function* (
+      space: Info,
+      url: URL | string,
+      headers: HeadersInit | undefined,
+    ) {
+      const historyResponse = yield* http.execute(
+        HttpClientRequest.post(route(url, "/sync/history"), {
+          headers: new Headers(headers),
